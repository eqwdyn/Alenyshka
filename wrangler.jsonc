{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "alenyshka-landing",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-28",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}